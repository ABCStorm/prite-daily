# Copy this file to .env.local and fill in the two values from your Supabase
# project (Project Settings → API). Both are safe to expose in a browser app
# (the anon key is protected by Row-Level Security). Restart `npm run dev` after
# editing.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-anon-public-key
