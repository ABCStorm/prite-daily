# Copy this file to .env.local and fill in the two values from your Supabase
# project (Project Settings → API). Both are safe to expose in a browser app
# (the anon key is protected by Row-Level Security). Restart `npm run dev` after
# editing.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-anon-public-key

# Optional. Origin of the Worker that serves the Kaplan & Sadock citations and
# page screenshots from a private R2 bucket (see workers/textbook-images).
# Only set this if the Worker moves off its workers.dev URL — the app already
# defaults to the deployed one, so the Textbook tab works without it.
# VITE_TEXTBOOK_BASE=https://textbook-images.correllsoftware.workers.dev

# Optional. Semantic Scholar Academic Graph key for the research-articles
# residual re-query pipeline (scripts/research-articles/semantic_scholar.py).
# Also accepted as S2_API_KEY. Rate limit is 1 request/second cumulative —
# the client paces at ~1.1s between calls. Never commit a real key.
# SEMANTIC_SCHOLAR_API_KEY=s2k-your-key-here

# Optional. xAI / Grok API key for residual Further-reading LLM judging
# (scripts/research-articles/judge_requery_grok.py). If unset, the judge falls
# back to your logged-in Grok CLI subscription token (~/.grok/auth.json).
# XAI_API_KEY=xai-your-key-here
