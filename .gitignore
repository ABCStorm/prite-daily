# context-generation scratch (keep the .mjs scripts + the canonical
# extraction/output/question_context.json, drop the per-batch intermediates)
extraction/context_gen/in/
extraction/context_gen/out/
extraction/context_gen/sql_parts/

# Supabase CLI local link/cache state (machine-specific)
supabase/.temp/

# Explanation-reformatting scratch: per-batch in/out files for the cheap-model
# formatting pass. The canonical result lands in extraction/output/questions_all.json.
extraction/output/_fmt/batches/

# Rebuildable local cache and large joined MP3s for offline audio exports.
extraction/output/audio_clips_v3/
extraction/output/audio_clips_v4_open_ended/
extraction/output/audio_exports/
extraction/output/audio_exports.state.json
extraction/output/audio_exports.v2.state.json
