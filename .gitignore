extraction/output/audio_r2_v3_48k_staging/
extraction/output/audio_r2_v2_delete.state.json

# Local research/reference cache for content generation (large, not needed at runtime)
reference/

# "In practice" illustration pipeline: generated images and blinded copies are
# working files (hundreds of MB at full scale). prompts.json IS committed.
enrichment/illustrations/images/
enrichment/illustrations/blind/
enrichment/illustrations/compare*.html
enrichment/illustrations/*.jsonl

# AnKing/Sketchy image pipeline: the extracted media (400 MB, 1,881 files) and
# its scratch dir are derived from the Anki decks and live in the private R2
# bucket `anking-sketchy-images` at runtime. The match manifests ARE committed.
enrichment/anking-images/media/
enrichment/anking-images/_work/
enrichment/anking-images/_upload_logs/

# Podcast matching pipeline: raw feed/transcript cache (~443 MB), rebuildable
# with `npm run podcasts:index`. public/data/podcasts.json IS committed.
scripts/podcasts/.cache/
